{
  "version": 3,

  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",

      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",

      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "NEXUSWASM_BUILD_TESTS": "ON",
        "NEXUSWASM_BUILD_EXAMPLES": "ON",
        "NEXUSWASM_BUILD_BENCHMARKS": "OFF",
        "NEXUSWASM_WARNINGS_AS_ERRORS": "OFF"
      }
    },

    {
      "name": "debug",
      "inherits": "base",

      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_SHARED_LIBS": "OFF"
      }
    },

    {
      "name": "release",
      "inherits": "base",

      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SHARED_LIBS": "OFF"
      }
    },

    {
      "name": "debug-shared",
      "inherits": "base",

      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_SHARED_LIBS": "ON"
      }
    },

    {
      "name": "release-shared",
      "inherits": "base",

      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SHARED_LIBS": "ON"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },

    {
      "name": "release",
      "configurePreset": "release"
    },

    {
      "name": "debug-shared",
      "configurePreset": "debug-shared"
    },

    {
      "name": "release-shared",
      "configurePreset": "release-shared"
    }
  ],

  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",

      "output": {
        "outputOnFailure": true
      }
    },

    {
      "name": "release",
      "configurePreset": "release",

      "output": {
        "outputOnFailure": true
      }
    },

    {
      "name": "debug-shared",
      "configurePreset": "debug-shared",

      "output": {
        "outputOnFailure": true
      }
    },

    {
      "name": "release-shared",
      "configurePreset": "release-shared",

      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
